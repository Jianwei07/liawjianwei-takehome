# =============================================================================
# REPO OVERVIEW FOR READERS
# =============================================================================
# This repo has three deliverables:
#
#   part-a/   — System design markdown → compiled to PDF via report-gen/
#   part-b/   — Python eval harness CLI (zero runtime deps, stdlib only)
#   part-c/   — Opinion piece markdown → compiled to PDF via report-gen/
#   report-gen/ — md-to-pdf tooling (Node.js); run `pnpm run build:all` there
#
# See README.md at the repo root for the full picture.
# =============================================================================


# =============================================================================
# PYTHON (part-b/)
# =============================================================================

# Bytecode cache — auto-generated by CPython, not part of source
__pycache__/
*.py[cod]
*.pyo

# Virtual environments — local per-developer, never shared
# Created by: uv venv  (preferred) or python -m venv
.venv/
venv/
env/

# uv lock file (committed if this were a deployed app; omitted for a CLI tool)
# uv.lock

# Editable install metadata — created by `pip install -e .`
*.egg-info/
.eggs/

# Test runner cache — pytest creates this; not source
.pytest_cache/

# Coverage reports
.coverage
htmlcov/


# =============================================================================
# NODE / REPORT-GEN (report-gen/)
# =============================================================================

# Node modules — restored by `pnpm install`, not committed
node_modules/

# pnpm store
.pnpm-store/


# =============================================================================
# OPERATING SYSTEM
# =============================================================================

# macOS metadata files — created by Finder, never meaningful in a repo
.DS_Store

# Windows thumbnail cache
Thumbs.db


# =============================================================================
# EDITORS
# =============================================================================

.vscode/
.idea/
*.swp
*.swo


# =============================================================================
# NOTE: *.pdf files are NOT ignored
# =============================================================================
# The generated PDFs (part-a/system-design.pdf, part-c/opinion.pdf) ARE
# committed as submission artifacts so the reviewer can open them directly
# without running the build toolchain.
# =============================================================================
